# ==============================================================================
# ZENCODE / PASEO ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or set these environment variables in your deployment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME & NETWORK
# ------------------------------------------------------------------------------
NODE_ENV=development
# Listen address: host:port, /path/to/socket, or unix:///path/to/socket
PASEO_LISTEN=127.0.0.1:6768
# Storage root for runtime states, sessions, and agent workspace caches
PASEO_HOME=~/.paseo
# Enable the built-in Expo Web UI single page app (accessible at /open-project)
PASEO_WEB_UI_ENABLED=true
# URL prefix for public asset generation or redirects
ZENCODE_APP_URL=https://app.zencode.vn

# ------------------------------------------------------------------------------
# 2. DUAL-ENGINE DATABASE ARCHITECTURE
# ------------------------------------------------------------------------------
# Primary Local Engine: High-performance SQLite with WAL journaling
ZENCODE_DATABASE_PATH=packages/server/data/zencode_master.db

# Master Production Engine: Enterprise PostgreSQL (Used for central credit settlement)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=zencode_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH ONBOARDING & AUTHENTICATION
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Set to 'true' in development to allow mock Google tokens during unit/e2e testing
ALLOW_DEV_MOCK_AUTH=false

# ------------------------------------------------------------------------------
# 4. VIETQR & SEPAY PAYMENT GATEWAY (AUTOMATED BILLING)
# ------------------------------------------------------------------------------
# Webhook secret key issued in your SePay merchant dashboard
SEPAY_API_KEY=your_sepay_webhook_secret_key_here
# Bank receiving information rendered on dynamic VietQR checkout
SEPAY_BANK_NAME=MBBank
SEPAY_BANK_ACCOUNT=0988776655
SEPAY_ACCOUNT_HOLDER="CONG TY ZENCODE"

# ------------------------------------------------------------------------------
# 5. SOVEREIGN STEALTH MODE & EGRESS PROXY INVARIANTS (GEMINI.md)
# ------------------------------------------------------------------------------
# All external AI interactions strictly enforce Zero Outbound Telemetry.
# Proxies are isolated 1:1 per node (ports 20128 - 20148).
# Internal cluster traffic MUST bypass proxies:
NO_PROXY=localhost,127.0.0.1,::1,*.modal.run,modal.direct

# ------------------------------------------------------------------------------
# 6. INCIDENT ALERTS & TELEGRAM NOTIFICATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 7. OPTIONAL AI MODEL PROVIDERS (LEGACY / ENTERPRISE)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MODAL_API_KEY=

# ------------------------------------------------------------------------------
# 8. DEBUGGING & TRACING FLAGS
# ------------------------------------------------------------------------------
# PASEO_DICTATION_DEBUG=1
# PASEO_CLAUDE_DEBUG=1
# PASEO_LOG_LEVEL=info
